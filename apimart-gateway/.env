# gateway 运行时凭据（从上游 lovartproxy.py 取来，仅本机 .env 持有，勿提交）
LOVART_BASE_URL=https://lgw.lovart.ai
LOVART_ACCESS_KEY=ak_ff406a1798cef649938a09e5ab412555
LOVART_SECRET_KEY=sk_63a1600463f54ddb6d942801e97b865b4e570e2c6abd86a80d69595948b07f4d

# 多用户映射：{"用户Key（无限画布填的 APIMart Key）": "ak|sk"}

# 网关行为
OPEN_RELAY=true
AUTO_CONFIRM=true
# 生成模式：unlimited（免费排队，自动确认不扣积分）/ fast（花积分即时）/ 空=沿用账号默认
# 用户明确要求 fast：花积分即时出图。前端不支持手动确认，必须自动确认。
LOVART_MODE=fast
# 推理模式（chat 线程级，独立于上面的生成模式 fast）：聊天用 thinking 深度推理；图像/视频生成不传 mode，默认即 fast
LOVART_CHAT_MODE=thinking
TASK_RESULT_TTL=86400
CHAT_SYNC_TIMEOUT=180
