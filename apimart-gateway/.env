# ============ Lovart 上游（真正干活的服务）============
LOVART_BASE_URL=https://lgw.lovart.ai
# ⚠️ 占位凭据：请替换为你的真实 Lovart AK/SK 后，生图/对话才会真正生效。
# 当前 OPEN_RELAY=true，任意 Bearer Key 均可，网关会用下面这对兜底凭据去调 Lovart。
LOVART_ACCESS_KEY=ak_xxxx_REPLACE_ME
LOVART_SECRET_KEY=sk_xxxx_REPLACE_ME

# 可选：过 Cloudflare 时带上 __cf_bm cookie
CF_BM=
# 可选：处于 TLS 拦截代理后设 1 关闭证书校验
LOVART_INSECURE_SSL=

# ============ 多租户（可选）============
USER_KEYS={}

# ============ 网关行为 ============
# 开放中继：true=任意/无 Bearer 都用默认（占位）凭据。仅供本地框架/内网使用。
OPEN_RELAY=true
# 高成本确认（视频等）自动确认继续
AUTO_CONFIRM=true
# 生成模式：fast / unlimited / 留空
LOVART_MODE=
LOVART_CHAT_MODE=thinking
LOVART_TIMEOUT=600
TASK_RESULT_TTL=86400
CHAT_SYNC_TIMEOUT=180
