# =============================================================
# localTool/.env.example — AI 操控画布（A1 本地 Agent）配置模板
#
# 用法：复制本文件为 localTool/.env 并填入真实值。
#       localTool/.env 已被 .gitignore 忽略，含密钥也不会入库。
#
# 说明（docs/27-AI操控画布-定稿方案.md §4/§7）：
# - A1 画布助手后端需要一个「支持 function calling」的 OpenAI 兼容 LLM，
#   现有 apimart-gateway(:9004) 是 Lovart 纯中转、不返回 tool_calls，无法驱动。
# - 本文件是全量配置；换任何 OpenAI 兼容服务（DeepSeek/魔搭/通义/OpenAI）只需改
#   LLM_CHAT_BASE_URL + LLM_CHAT_API_KEY + LLM_CHAT_MODEL 三项，不用改代码。
# =============================================================

# ── 必配：LLM 渠道（支持 function calling）──

# OpenAI 兼容端点。示例：
#   魔搭：   https://api-inference.modelscope.cn/v1/chat/completions
#   DeepSeek: https://api.deepseek.com/v1/chat/completions
#   通义：   https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
#   OpenAI： https://api.openai.com/v1/chat/completions
LLM_CHAT_BASE_URL=https://api-inference.modelscope.cn/v1/chat/completions

# 端点 API Key（必填，否则上游 401）
LLM_CHAT_API_KEY=ms-xxxxxxxx

# 模型 ID（必配；覆盖前端传来的 defaultModel，如 gpt-4o-mini）。
# 魔搭为 {owner}/{model_name}，需支持 function calling。已实测 Qwen3-14B 可用。
#   魔搭：Qwen/Qwen3-14B、Qwen/Qwen3-8B、Qwen/Qwen3-32B、MiniMax/MiniMax-M2.5、ZhipuAI/GLM-4.7-Flash
#   DeepSeek：deepseek-chat / deepseek-reasoner
LLM_CHAT_MODEL=Qwen/Qwen3-14B

# ── 可选：行为调优 ──

# 上游总超时（毫秒，含流透传；默认 120000）
# LLM_CHAT_TIMEOUT_MS=120000

# 是否注入「画布操作准则」system（'0' 关闭，其余默认开启）
# AI_CANVAS_ENHANCE=1

# 是否对 canvas-assistant 的 vip-check 本地放行（'0' 关闭，其余默认开启）
# AI_CANVAS_LOCAL=1

# 自定义准则提示词文件（绝对路径）；缺省用内置常量。文件内容会作为 system 注入。
# AI_CANVAS_SYSTEM_PROMPT_FILE=/absolute/path/to/canvas_rules.txt
