# ════════════════════════════════════════════════════════════════
# .gitignore · 一毛AI画布多端合一（自研后端替代版）
# 依据 CLAUDE.md §四 开发红线与分层铁律整理：
#   - 运行只读 dist/，src/bundle/ 是可编辑工程源码（应入库）
#   - localTool/dist/ 是 tsc 产物（不入库）
#   - apimart-gateway/.env 含真实 AK/SK（绝不入库）
# ════════════════════════════════════════════════════════════════

# ── 依赖（体积大、可重装，不纳入版本库）──
node_modules/

# ── 构建产物 ──
# localTool 的 tsc 编译产物（由 localTool/src 重建，不入库）
localTool/dist/
# 根前端 dist/：src/bundle/ 经 `npm run build` 回灌的运行时产物，
# 运行只读、每次 build 必变，属构建产物，不入库（见 CLAUDE.md §四.2/§四.5）。
dist/

# Vite / TS 构建缓存与类型增量
.vite/
*.tsbuildinfo

# ── Python ──
__pycache__/
*.pyc
apimart-gateway/venv/

# ── 环境变量 / 密钥（含真实 Lovart AK/SK，绝不入库）──
.env
.env.*
apimart-gateway/.env

# ── 闭源引擎二进制交付物（无源码、体积大，仅本地运行用）──
*.exe
一毛AI画布引擎Mac端Arm版
一毛AI画布引擎Mac端Intel版

# ── dist 原版备份（美化前的单行压缩版，仅本地回退用）──
dist-orig/

# ── readable 阅读副本（rename.cjs 生成、与 src/bundle 1:1、可随时重建，不入库）──
# 由 scripts/rename.cjs 递归生成；_smoke_checks.checkReadableParity 缺失时会自动重建。
readable/

# ── 逆向还原目录：整目录入库（含中间产物 pipeline/dist/step0_raw/verifiers），仅忽略其下的系统文件 ──
# 注：CLAUDE.md §四.4 标注此目录「AI 禁止读」，但需随仓库分发，故纳入版本库。

# ── 运行时日志（启动脚本落盘，含 [proxy] 转发明细）──
logs/
*.log
apimart-gateway/apimart_9004.log
apimart-gateway/apimart_9004.err.log
localTool/localtool_18080.log
localTool/localtool_18080.err.log

# ── 系统 / 编辑器 / 项目数据 ──
.DS_Store
Thumbs.db

# ── 守护进程 PID 锁文件（launch-all.ps1 单实例保护，运行期生成）──
.watchdog.lock
